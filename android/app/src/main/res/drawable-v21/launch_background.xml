<?xml version="1.0" encoding="utf-8"?>
<!-- Same diagonal gradient as the Flutter startup screen (theme background,
     surfaceVariant, surface), so the window does not change colour when
     Flutter draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/startup_background_start"
                android:centerColor="@color/startup_background_center"
                android:endColor="@color/startup_background_end" />
        </shape>
    </item>
</layer-list>
